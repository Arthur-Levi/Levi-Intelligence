REDIS_URL=redis://localhost:6379/0
CORS_ORIGINS=http://localhost:5173
LOG_LEVEL=INFO

APIFY_API_TOKEN=
APIFY_ACTOR_ID=
WORKER_POLL_SECONDS=2.0
DISCOVERY_MAX_ATTEMPTS=3
